APP_NAME="Sistem Manajemen Limbah"
APP_ENV=local
# Generate new key with: php artisan key:generate
APP_KEY=base64:CHANGE_ME_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Debugging Configuration
APP_LOG_LEVEL=debug
DB_LOG_QUERIES=false
LOG_QUERY_SLOW_QUERIES=true
LOG_SLOW_QUERY_THRESHOLD=2000

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Alternative SQLite for development (Default for CI/Setup)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_ENCRYPT=true for production (encrypt session data)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@k3limbah.com"
MAIL_FROM_NAME="${APP_NAME}"

# Application Specific Settings
APP_TIMEZONE=Asia/Jakarta
APP_PAGINATION_LIMIT=10
APP_MAX_UPLOAD_SIZE=10240

# Super Admin Configuration
# Konfigurasi untuk Super Admin default. Jika tidak di-set, akan menggunakan nilai default dari seeder
# SECURITY: SELALUB UBAH PASSWORD INI DI PRODUCTION!
SUPERADMIN_EMAIL="superadmin@waspro.com"
SUPERADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"
SUPERADMIN_NAME="Super Administrator"

# Security Settings
# IMPORTANT: For PRODUCTION, set SESSION_SECURE_COOKIE=true (requires HTTPS)
# IMPORTANT: For PRODUCTION, set SESSION_SAME_SITE=strict (better CSRF)
# Values below are for LOCAL DEVELOPMENT (HTTP)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true
API_RATE_LIMIT=120
API_RATE_LIMIT_DECAY_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
